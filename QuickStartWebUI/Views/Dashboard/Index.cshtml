@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content-wrapper pb-0">
    <div class="page-header flex-wrap">
        <h3 class="mb-0">
            İstatistik sayfasına hoşgeldiniz <span class="pl-0 h6 pl-sm-2 text-muted d-inline-block">Web sitenizin güncel analitik verileri.</span>
        </h3>
    </div>

    <div class="row">
        <!-- 1. Sütun: Müşteriler ve Hizmetler -->
        <div class="col-xl-4 col-lg-12 stretch-card grid-margin">
            <div class="row w-100">
                <!-- Müşteri Sayısı -->
                <div class="col-xl-12 col-md-6 stretch-card grid-margin grid-margin-sm-0 pb-sm-3">
                    <div class="card bg-warning">
                        <div class="card-body px-3 py-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="color-card">
                                    <p class="mb-0 color-card-head">Müşteriler</p>
                                    <h2 class="text-white">@ViewBag.TestimonialCount</h2>
                                </div>
                                <i class="card-icon-indicator mdi mdi-account-star bg-inverse-icon-warning"></i>
                            </div>
                            <h6 class="text-white">Toplam Müşteri Yorumu</h6>
                        </div>
                    </div>
                </div>
                <!-- Hizmet Sayısı -->
                <div class="col-xl-12 col-md-6 stretch-card grid-margin grid-margin-sm-0 pb-sm-3">
                    <div class="card bg-danger">
                        <div class="card-body px-3 py-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="color-card">
                                    <p class="mb-0 color-card-head">Hizmetler</p>
                                    <h2 class="text-white">@ViewBag.ServiceCount</h2>
                                </div>
                                <i class="card-icon-indicator mdi mdi-briefcase-check bg-inverse-icon-danger"></i>
                            </div>
                            <h6 class="text-white">Aktif Sunulan Hizmetler</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Sütun: Galeri ve Öne Çıkanlar -->
        <div class="col-xl-4 col-lg-12 stretch-card grid-margin">
            <div class="row w-100">
                <!-- Galeri Sayısı -->
                <div class="col-xl-12 col-md-6 stretch-card grid-margin grid-margin-sm-0 pb-sm-3">
                    <div class="card bg-primary">
                        <div class="card-body px-3 py-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="color-card">
                                    <p class="mb-0 color-card-head">Galeri</p>
                                    <h2 class="text-white">@ViewBag.GalleryCount</h2>
                                </div>
                                <i class="card-icon-indicator mdi mdi-image-multiple bg-inverse-icon-primary"></i>
                            </div>
                            <h6 class="text-white">Toplam Görsel Sayısı</h6>
                        </div>
                    </div>
                </div>
                <!-- Öne Çıkanlar -->
                <div class="col-xl-12 col-md-6 stretch-card grid-margin grid-margin-sm-0 pb-sm-3">
                    <div class="card bg-success">
                        <div class="card-body px-3 py-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="color-card">
                                    <p class="mb-0 color-card-head">Öne Çıkanlar</p>
                                    <h2 class="text-white">@ViewBag.FeatureCount</h2>
                                </div>
                                <i class="card-icon-indicator mdi mdi-star-circle bg-inverse-icon-success"></i>
                            </div>
                            <h6 class="text-white">Öne Çıkan Başlık Sayısı</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Sütun: Aboneler ve Ekip -->
        <div class="col-xl-4 col-lg-12 stretch-card grid-margin">
            <div class="row w-100">
                <!-- Abone Sayısı -->
                <div class="col-xl-12 col-md-6 stretch-card grid-margin grid-margin-sm-0 pb-sm-3">
                    <div class="card bg-info" style="background-color: #00d2ff !important;">
                        <div class="card-body px-3 py-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="color-card">
                                    <p class="mb-0 color-card-head">Aboneler</p>
                                    <h2 class="text-white">@ViewBag.SubscribeCount</h2>
                                </div>
                                <i class="card-icon-indicator mdi mdi-email-open bg-inverse-icon-info"></i>
                            </div>
                            <h6 class="text-white">Bülten Abone Sayısı</h6>
                        </div>
                    </div>
                </div>
                <!-- Ekip Sayısı -->
                <div class="col-xl-12 col-md-6 stretch-card grid-margin grid-margin-sm-0 pb-sm-3">
                    <div class="card bg-dark">
                        <div class="card-body px-3 py-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="color-card">
                                    <p class="mb-0 color-card-head">Ekibimiz</p>
                                    <h2 class="text-white">@ViewBag.TeamCount</h2>
                                </div>
                                <i class="card-icon-indicator mdi mdi-account-group bg-inverse-icon-dark"></i>
                            </div>
                            <h6 class="text-white">Aktif Personel Sayısı</h6>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model QuickStartWebUI.DTOs.Features.UpdateFeatureDto
@{
    ViewData["Title"] = "Özellik Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Özellik Güncelleme Sayfası</h6>
                <form method="post" asp-area="Admin" asp-controller="Feature" asp-action="UpdateFeature">
                    <input type="hidden" asp-for="FeatureId" />

                    <div class="mb-3">
                        <label class="form-label">Özellik Başlığı</label>
                        <input type="text" asp-for="Title" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sayısal Değer</label>
                        <input type="number" asp-for="Number" class="form-control">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">İkon Sınıfı</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fa @Model.IconUrl text-primary"></i>
                            </span>
                            <input type="text" asp-for="IconUrl" class="form-control">
                        </div>
                        <small class="text-muted">Mevcut İkon: @Model.IconUrl</small>
                    </div>

                    <button type="submit" class="btn btn-success">Değişiklikleri Uygula</button>
                    <a href="/Feature/Index" class="btn btn-secondary">İptal</a>
                </form>
            </div>
        </div>
    </div>
</div>
@model QuickStartWebUI.DTOs.Features.CreateFeatureDto
@{
    ViewData["Title"] = "Yeni Özellik Ekle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Yeni Özellik / İstatistik Ekle</h6>
                <form method="post" asp-controller="Feature" asp-action="CreateFeature">
                    <div class="mb-3">
                        <label class="form-label">Özellik Başlığı</label>
                        <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Yıllık Tecrübe">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sayısal Değer (Number)</label>
                        <input type="number" asp-for="Number" class="form-control" placeholder="Örn: 50">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">İkon Sınıfı (FontAwesome)</label>
                        <input type="text" asp-for="IconUrl" class="form-control" placeholder="Örn: fa-certificate">
                        <small class="text-muted">Kullanılabilir ikonlar: fa-users, fa-certificate, fa-bread-slice, fa-cart-plus</small>
                    </div>
                    <button type="submit" class="btn btn-primary">Özelliği Kaydet</button>
                    <a href="/Feature/Index" class="btn btn-secondary">Vazgeç</a>
                </form>
            </div>
        </div>
    </div>
</div>
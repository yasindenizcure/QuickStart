@model QuickStartWebUI.DTOs.Subscribes.UpdateSubscribeDto

@{
    ViewData["Title"] = "Abone Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Abone Güncelleme Sayfası</h6>
                <form asp-controller="Subscribe" asp-action="UpdateSubscribe" method="post">
                    <input type="hidden" asp-for="SubscribeId" />
                    <input asp-for="Email" class="form-control" />
                    <button type="submit">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>
@model List<QuickStartWebUI.DTOs.Subscribes.ResultSubscribeDto>
@{
    ViewData["Title"] = "Aboneler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}
<div class="container-fluid pt-4 px-4">
    <div class="bg-light text-center rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h6 class="mb-0">Bülten Aboneleri Listesi</h6>
        </div>
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead>
                    <tr class="text-dark">
                        <th scope="col">#</th>
                        <th scope="col">E-posta Adresi</th>
                        <th scope="col">Sil</th>
                        <th scope="col">Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>
                            <td>@item.Email</td>
                            <td>
                                <a class="btn btn-sm btn-outline-danger"
                                   href="/Subscribe/DeleteSubscribe/@item.SubscribeId"
                                   onclick="return confirm('Bu aboneyi silmek istediğinize emin misiniz?')">
                                    <i class="fa fa-trash"></i> Sil
                                </a>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-info"
                                   href="/Subscribe/UpdateSubscribe/@item.SubscribeId">
                                    <i class="fa fa-edit"></i> Güncelle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
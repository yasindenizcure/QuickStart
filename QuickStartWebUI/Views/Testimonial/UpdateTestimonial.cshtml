@model QuickStartWebUI.DTOs.Testimonials.UpdateTestimonialDto
@{
    ViewData["Title"] = "Referans Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Referans Bilgilerini Düzenle</h6>
                <form method="post" asp-controller="Testimonial" asp-action="UpdateTestimonial">
                    <input type="hidden" asp-for="testimonialId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ad Soyad</label>
                            <input type="text" asp-for="fullName" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Unvan / Meslek</label>
                            <input type="text" asp-for="title" class="form-control">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Puan (1 - 5)</label>
                            <input type="number" asp-for="rate" class="form-control" min="1" max="5">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Görsel URL</label>
                            <input type="text" asp-for="imageUrl" class="form-control">
                        </div>
                    </div>

                    @if (Model != null && !string.IsNullOrEmpty(Model.imageUrl))
                    {
                        <div class="mb-3">
                            <small class="text-muted">Mevcut Görsel:</small><br />
                            <img src="@Model.imageUrl" style="width: 80px; height: 80px; object-fit: cover; border-radius: 50%; border: 1px solid #ddd;" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Müşteri Yorumu</label>
                        <textarea asp-for="description" rows="5" class="form-control"></textarea>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success"><i class="fa fa-sync me-2"></i>Güncelle</button>
                        <a href="/Testimonial/Index" class="btn btn-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
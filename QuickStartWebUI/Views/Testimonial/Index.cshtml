@model List<QuickStartWebUI.DTOs.Testimonials.ResultTestimonialDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Müşteri Listesi</h4>
            <p class="card-description">
            </p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Resmi</th>
                            <th>Adı Soyadı</th>
                            <th>Mesleği</th>
                            <th>Yorum</th>
                            <th>Puanı</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-1">
                                    <img src="@item.imageUrl" alt="image" />
                                </td>
                                <td>@item.fullName</td>
                                <td>@item.title</td>
                                <td>@item.description</td>
                                <td>@item.rate</td>
                                <td><a href="/Testimonial/DeleteTestimonial/@item.testimonialId" class="btn btn-danger">Sil</a></td>
                                <td><a href="/Testimonial/UpdateTestimonial/@item.testimonialId" class="btn btn-warning">Güncelle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a href="/Testimonial/CreateTestimonial/" class="btn btn-warning">Yeni Müşteri Ekle</a>
            </div>
        </div>
    </div>
</div>
@model CreateNotificationDto
@{
    ViewData["Title"] = "Yeni Bildirim";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card shadow-sm" style="border-radius: 15px; border: none;">
        <div class="card-body p-5">
            <h4 class="card-title text-success mb-4">Yeni Bildirim Oluştur</h4>
            <form class="forms-sample" method="post">
                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group mb-4">
                            <label class="font-weight-bold">Konu / Başlık</label>
                            <input type="text" class="form-control form-control-lg" asp-for="Title" placeholder="Başlık giriniz..." style="border-radius: 10px;">
                        </div>
                        <div class="form-group mb-4">
                            <label class="font-weight-bold">Detaylı Mesaj</label>
                            <textarea class="form-control" asp-for="Content" rows="6" placeholder="Mesaj içeriğini buraya yazın..." style="border-radius: 10px; resize: none;"></textarea>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4" style="background-color: #f8f9fa; border-radius: 15px; border: 1px solid #edf1f2;">
                            <div class="form-group mb-4">
                                <label class="font-weight-bold text-dark">Bildirim Türü</label>
                                <input type="text" class="form-control" asp-for="Name" placeholder="Örn: Uyarı, Bilgi, Şikayet" style="border-radius: 10px;">
                            </div>
                            <button type="submit" class="btn btn-success btn-lg btn-block shadow-sm" style="border-radius: 12px; font-weight: 600;">
                                <i class="mdi mdi-check-circle mr-2"></i>Yayınla
                            </button>
                            <a href="/Notification/Index" class="btn btn-light btn-block mt-2" style="border-radius: 12px;">İptal</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
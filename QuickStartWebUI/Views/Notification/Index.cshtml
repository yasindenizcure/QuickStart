@model List<QuickStartWebUI.DTOs.Notifications.ResultNotificationWithNotificationsTypeDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Müşteri Listesi</h4>
            <p class="card-description">
            </p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>İçerik</th>
                            <th>Durum</th>
                            <th>Tür</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.NotificationId</td>
                                <td>@item.Title</td>
                                <td>@item.Content</td>
                                <td>@(item.IsRead ? "Okundu" : "Okunmadı")</td>
                                <td>@item.Name</td>
                                <td><a href="/Notification/DeleteNotification/@item.NotificationId" class="btn btn-danger">Sil</a></td>
                                <td><a href="/Notification/UpdateNotification/@item.NotificationId" class="btn btn-warning">Güncelle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a href="/Notification/AddNotification/" class="btn btn-warning">Yeni Bildirim Ekle</a>
            </div>
        </div>
    </div>
</div>
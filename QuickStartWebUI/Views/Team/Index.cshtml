@using QuickStartWebUI.DTOs.Teams
@model List<ResultTeamDto>
@{
    ViewData["Title"] = "Ekip Arkadaşlarımız";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light text-center rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h6 class="mb-0">Ekip Üyeleri Listesi</h6>
            <a href="/Team/CreateTeam" class="btn btn-primary"><i class="fa fa-plus me-2"></i>Yeni Üye Ekle</a>
        </div>
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead>
                    <tr class="text-dark">
                        <th scope="col">#</th>
                        <th scope="col">Görsel</th>
                        <th scope="col">Ad Soyad</th>
                        <th scope="col">Unvan</th>
                        <th scope="col">Sosyal Medya</th>
                        <th scope="col">Sil</th>
                        <th scope="col">Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>
                            <td>
                                <img src="@item.ImageUrl" style="width:50px; height:50px; object-fit:cover; border-radius:50%;" />
                            </td>
                            <td>@item.FullName</td>
                            <td>@item.Title</td>
                            <td>
                                <div class="d-flex gap-2">
                                    @if (!string.IsNullOrEmpty(item.SocialMedia1))
                                    {
                                        <i class="fab fa-facebook text-primary"></i>
                                    }
                                    @if (!string.IsNullOrEmpty(item.SocialMedia2))
                                    {
                                        <i class="fab fa-twitter text-info"></i>
                                    }
                                    @if (!string.IsNullOrEmpty(item.SocialMedia3))
                                    {
                                        <i class="fab fa-instagram text-danger"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-danger" href="/Team/DeleteTeam/@item.TeamId" onclick="return confirm('Silmek istediğinize emin misiniz?')"><i class="fa fa-trash"></i></a>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-info" href="/Team/UpdateTeam/@item.TeamId"><i class="fa fa-edit"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
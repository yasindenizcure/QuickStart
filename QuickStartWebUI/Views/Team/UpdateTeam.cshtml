@model QuickStartWebUI.DTOs.Teams.UpdateTeamDto
@{
    ViewData["Title"] = "Ekip Üyesi Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded h-100 p-4">
        <h6 class="mb-4">Üye Bilgilerini Güncelle</h6>
        <form method="post" asp-controller="Team" asp-action="UpdateTeam">
            <input type="hidden" asp-for="TeamId" />

            <div class="text-center mb-4">
                <img src="@Model.ImageUrl" class="rounded-circle border p-1" style="width:100px; height:100px; object-fit:cover;" />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ad Soyad</label>
                    <input type="text" asp-for="FullName" class="form-control">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Unvan</label>
                    <input type="text" asp-for="Title" class="form-control">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Görsel URL</label>
                <input type="text" asp-for="ImageUrl" class="form-control">
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Facebook</label>
                    <input type="text" asp-for="SocialMedia1" class="form-control">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Twitter</label>
                    <input type="text" asp-for="SocialMedia2" class="form-control">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Instagram</label>
                    <input type="text" asp-for="SocialMedia3" class="form-control">
                </div>
            </div>
            <button type="submit" class="btn btn-success">Değişiklikleri Kaydet</button>
            <a href="/Team/Index" class="btn btn-secondary">İptal</a>
        </form>
    </div>
</div>
@model QuickStartWebUI.DTOs.Teams.CreateTeamDto
@{
    ViewData["Title"] = "Yeni Ekip Üyesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light rounded h-100 p-4">
        <h6 class="mb-4">Yeni Ekip Üyesi Ekle</h6>
        <form method="post" asp-controller="Team" asp-action="CreateTeam">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ad Soyad</label>
                    <input type="text" asp-for="FullName" class="form-control" placeholder="Ad Soyad giriniz">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Unvan</label>
                    <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Baş Fırıncı">
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Görsel URL</label>
                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="Fotoğraf linki">
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Facebook (URL)</label>
                    <input type="text" asp-for="SocialMedia1" class="form-control">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Twitter (URL)</label>
                    <input type="text" asp-for="SocialMedia2" class="form-control">
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Instagram (URL)</label>
                    <input type="text" asp-for="SocialMedia3" class="form-control">
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Üyeyi Kaydet</button>
            <a href="/Team/Index" class="btn btn-secondary">Vazgeç</a>
        </form>
    </div>
</div>
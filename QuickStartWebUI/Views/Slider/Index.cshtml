@model List<QuickStartWebUI.DTOs.Sliders.ResultSliderDto>
@{
    ViewData["Title"] = "Slider Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Slider Listesi</h4>
            <p class="card-description"> Web sitesi ana sayfa görsellerini buradan yönetebilirsiniz. </p>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Görsel</th>
                            <th>Başlık</th>
                            <th>Ana Başlık</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SliderId</td>
                                <td><img src="@item.ImageUrl" alt="slider" style="width:70px; height:40px; border-radius:0px;" /></td>
                                <td>@item.Title</td>
                                <td>@item.MainTitle</td>
                                <td>
                                    <a href="/Slider/UpdateSlider/@item.SliderId" class="btn btn-outline-info">Güncelle</a>
                                    <a href="/Slider/DeleteSlider/@item.SliderId" class="btn btn-outline-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a href="/Slider/CreateSlider/" class="btn btn-primary">Yeni Slider Ekle</a>
            </div>
        </div>
    </div>
</div>
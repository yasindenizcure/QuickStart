@model QuickStartWebUI.DTOs.Galleries.UpdateGalleryDto
@{
    ViewData["Title"] = "Galeri Görseli Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Görsel Düzenleme Paneli</h6>
                <form method="post" asp-controller="Gallery" asp-action="UpdateGallery">
                    <input type="hidden" asp-for="GalleryId" />

                    <div class="mb-4 text-center">
                        <p class="text-muted">Mevcut Görsel Önizlemesi</p>
                        <img src="@Model.ImageUrl" alt="Galeri" style="max-width: 300px; max-height: 200px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" class="border p-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Görsel URL Adresi</label>
                        <input type="text" asp-for="ImageUrl" class="form-control">
                    </div>

                    <button type="submit" class="btn btn-success">
                        <i class="fa fa-sync me-2"></i>Değişiklikleri Kaydet
                    </button>
                    <a href="/Gallery/Index" class="btn btn-secondary">Geri Dön</a>
                </form>
            </div>
        </div>
    </div>
</div>
@using QuickStartWebUI.DTOs.Galleries
@model List<ResultGalleryDto>
@{
    ViewData["Title"] = "Galeri Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-light text-center rounded p-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h6 class="mb-0">Galeri Fotoğraf Listesi</h6>
            <a href="/Gallery/CreateGallery" class="btn btn-primary">
                <i class="fa fa-plus me-2"></i>Yeni Fotoğraf Ekle
            </a>
        </div>
        <div class="table-responsive">
            <table class="table text-start align-middle table-bordered table-hover mb-0">
                <thead>
                    <tr class="text-dark">
                        <th scope="col">#</th>
                        <th scope="col">Görsel</th>
                        <th scope="col">Görsel Yolu (URL)</th>
                        <th scope="col">Sil</th>
                        <th scope="col">Güncelle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>@count</td>
                            <td>
                                <img src="@item.ImageUrl" alt="Galeri" style="width:100px; height:60px; object-fit:cover; border-radius:5px; border: 1px solid #ddd;" />
                            </td>
                            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <small>@item.ImageUrl</small>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-danger"
                                   href="/Gallery/DeleteGallery/@item.GalleryId"
                                   onclick="return confirm('Bu fotoğrafı galeriden silmek istediğinize emin misiniz?')">
                                    <i class="fa fa-trash"></i> Sil
                                </a>
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-info"
                                   href="/Gallery/UpdateGallery/@item.GalleryId">
                                    <i class="fa fa-edit"></i> Güncelle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
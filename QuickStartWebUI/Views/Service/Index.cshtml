@model List<ResultServiceDto>

@{
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container">
    <br />
    <br />
    <table class="table table-bordered">
    <tr>
        <th>#</th>
        <th>Hizmet</th>
        <th>Açıklama</th>
        <th>Icon</th>
        <th>İşlemler</th>
        </tr>
    @foreach (var item in Model)
    {
     <tr>
         <td>@item.serviceId</td>
         <td>@item.title</td>
         <td>@item.description</td>
         <td>@item.iconUrl</td>
         <td><a href="/Service/DeleteService/@item.serviceId" class="btn btn-danger">Sil</a></td>
         <td><a href="/Service/UpdateService/@item.serviceId" class="btn btn-warning">Güncelle</a></td>
         </tr>
    }
    </table>
    <a href="/Service/CreateService/" class="btn btn-success">Ekle</a>
</div>
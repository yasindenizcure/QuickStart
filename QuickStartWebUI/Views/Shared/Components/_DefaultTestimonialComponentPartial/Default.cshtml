@model List<QuickStartWebUI.DTOs.Testimonials.ResultTestimonialDto>

<div class="container-xxl bg-light my-6 py-6 pb-0">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <p class="text-primary text-uppercase mb-2">// Müşteri Yorumları</p>
            <h1 class="display-6 mb-4">20.000'den Fazla Müşterimiz Bize Güvendi</h1>
        </div>

        <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.1s">

            @foreach (var item in Model)
            {
                <div class="testimonial-item bg-white rounded p-4">
                    <div class="d-flex align-items-center mb-4">
                        <img class="flex-shrink-0 rounded-circle border p-1" src="@item.imageUrl" alt="@item.fullName" style="width: 80px; height: 80px; object-fit: cover;">
                        <div class="ms-4">
                            <h5 class="mb-1">@item.fullName</h5>
                            <span>@item.title</span>
                            <div class="text-primary">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.rate)
                                    {
                                        <small class="fa fa-star"></small>
                                    }
                                    else
                                    {
                                        <small class="far fa-star"></small>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <p class="mb-0">@item.description</p>
                </div>
            }

        </div>
    </div>
</div>
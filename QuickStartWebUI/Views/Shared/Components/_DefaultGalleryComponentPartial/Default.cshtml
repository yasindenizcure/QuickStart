@model List<QuickStartWebUI.DTOs.Galleries.ResultGalleryDto>

<div class="col-lg-3 col-md-6">
    <h4 class="text-light mb-4">Fotoğraf Galerisi</h4>
    <div class="row g-2">
        @foreach (var item in Model.Take(6))
        {
            <div class="col-4">
                <img class="img-fluid bg-light rounded p-1"
                     src="@item.ImageUrl"
                     alt="Baker Galeri"
                     style="height: 70px; width: 100%; object-fit: cover;">
            </div>
        }
    </div>
</div>
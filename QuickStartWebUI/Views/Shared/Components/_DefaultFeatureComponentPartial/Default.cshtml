@model List<QuickStartWebUI.DTOs.Features.ResultFeatureDto>

<div class="container-xxl py-6">
    <div class="container">
        <div class="row g-4">
            @{
                double delay = 0.1;
            }
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-6 wow fadeIn" data-wow-delay="@(delay.ToString("0.1", System.Globalization.CultureInfo.InvariantCulture))s">
                    <div class="fact-item bg-light rounded text-center h-100 p-5">
                        <i class="fa @item.IconUrl fa-4x text-primary mb-4"></i>
                        <p class="mb-2">@item.Title</p>
                        <h1 class="display-5 mb-0" data-toggle="counter-up">@item.Number</h1>
                    </div>
                </div>
                delay += 0.2;
            }
        </div>
    </div>
</div>